@model IReadOnlyList<BandirmaCepte.Services.MunicipalNewsItem>
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bandırma Belediyesi Haberleri | Bandırma Cepte</title>
    <link rel="icon" type="image/png" href="/icon.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <main class="container py-5">
        <a href="/" class="btn btn-link text-decoration-none px-0 mb-3"><i class="fa-solid fa-arrow-left me-2"></i>Ana sayfaya dön</a>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <p class="text-primary text-uppercase fw-bold small mb-1">Bandırma Cepte</p>
                <h1 class="h2 fw-bold mb-0">Bandırma Belediyesi Haberleri</h1>
            </div>
            <span class="badge text-bg-primary">@Model.Count haber</span>
        </div>
        @if (ViewBag.NewsUnavailable == true)
        {
            <div class="alert alert-warning">Belediyenin haber sitesine şu anda ulaşılamıyor. Lütfen daha sonra tekrar deneyin.</div>
        }
        @if (Model.Count == 0 && ViewBag.NewsUnavailable != true)
        {
            <div class="alert alert-info">Kaynakta görüntülenecek haber bulunamadı.</div>
        }
        <div class="row g-4">
            @foreach (var news in Model)
            {
                <div class="col-md-6">
                    <article class="card h-100 border-0 shadow-sm">
                        <div class="card-body p-4 d-flex flex-column">
                            <span class="badge text-bg-primary align-self-start mb-3">@news.Source</span>
                            <h2 class="h5 fw-bold">@news.Title</h2>
                            @if (!string.IsNullOrWhiteSpace(news.Summary))
                            {
                                <p class="text-secondary">@news.Summary</p>
                            }
                            <a class="btn btn-outline-primary mt-auto align-self-start" href="@news.Url" target="_blank" rel="noopener noreferrer">Belediye sitesinde oku <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i></a>
                        </div>
                    </article>
                </div>
            }
        </div>
    </main>
</body>
</html>
